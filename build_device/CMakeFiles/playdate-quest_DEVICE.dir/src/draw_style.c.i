static inline __attribute__((always_inline)) __attribute__((__unused__)) void _drawMaskPattern(uint32_t* p, uint32_t mask, uint32_t color)
{
 if ( mask == 0xffffffff )
  *p = color;
 else
  *p = (*p & ~mask) | (color & mask);
}



static inline __attribute__((always_inline)) __attribute__((__unused__)) void draw_scanline_pattern(uint8_t* bitmap, int rowstride, const tri_edge* edge_l, const tri_edge* edge_r, const uint8_t* pattern)
{
